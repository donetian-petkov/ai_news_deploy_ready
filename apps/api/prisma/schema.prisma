generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppState {
  id        Int      @id
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsageSnapshot {
  id           Int      @id @default(autoincrement())
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  createdAt    DateTime @default(now())
}
