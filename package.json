{
  "name": "ai_news_next_node",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ai-news/api & npm run dev -w @ai-news/web",
    "dev:local": "bash ./scripts/dev-local.sh",
    "dev:web": "npm run dev -w @ai-news/web",
    "dev:api": "npm run dev -w @ai-news/api",
    "server": "node scripts/server-control.cjs",
    "server:status": "node scripts/server-control.cjs status",
    "server:stop": "node scripts/server-control.cjs stop",
    "stop": "node scripts/server-control.cjs stop",
    "build": "npm run build -w @ai-news/shared && npm run build -w @ai-news/api && npm run build -w @ai-news/web",
    "test": "npm run test -w @ai-news/web && npm run test -w @ai-news/shared",
    "test:all": "npm run test",
    "test:api": "npm run build -w @ai-news/shared && npm run build -w @ai-news/api && npm run test -w @ai-news/api",
    "test:e2e": "npm run test:e2e -w @ai-news/web",
    "test:smoke": "npm run test:api && npm run test:e2e",
    "capture:readme": "node scripts/capture-readme-screenshots.js",
    "start": "node scripts/run-stack.cjs",
    "start:local": "bash ./scripts/start-local.sh",
    "install:server": "bash ./scripts/install.sh",
    "start:server": "bash ./scripts/start.sh",
    "stop:local": "bash ./scripts/stop-local.sh",
    "restart:local": "bash ./scripts/restart-local.sh",
    "prisma:generate": "npm run prisma:generate -w @ai-news/api",
    "prisma:migrate": "npm run prisma:migrate -w @ai-news/api"
  }
}
